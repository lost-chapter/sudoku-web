{
  "name": "@sudoku/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm sync:puzzles && vite",
    "build": "pnpm sync:puzzles && vite build",
    "preview": "vite preview",
